# ==========================================
# AUTO-APPLY EXTENSION ENVIRONMENT VARIABLES
# ==========================================
# Note: You only need to edit the .env file.
# Copy this file to .env and change the values based on your target environment.

# 1. Base URL for API requests (Aladdin backend)
# This dictates which environment the extension talks to.
#
# Choose ONE of the following for your current test:
#
# For Local Development:
VITE_ALADDIN_BASE_URL=http://localhost:3000
#
# For Staging:
# VITE_ALADDIN_BASE_URL=https://aladdin-staging.vercel.app
#
# For Production:
# VITE_ALADDIN_BASE_URL=https://dashboard.myaladdin.app

# 2. Chrome Extension ID
# This is required so the web app (backend) can securely message the extension
# during the sign-in flow. Replace this with your actual unpacked extension ID.
VITE_EXTENSION_ID=hemlnonpclohndjbmfpckdigielkemod

# ==========================================
# IMPORTANT SECURITY NOTE REGARDING LLM KEYS
# ==========================================
# DO NOT add OpenAI, Anthropic, or any other LLM API keys to this file.
# Browser extensions are essentially public clients. Any API key embedded
# in the extension can be easily extracted by malicious users.
# 
# The current architecture securely proxies all LLM requests through the
# Aladdin backend (`/api/extension/answer`). Keep your LLM API keys
# on your backend server (`.env.local` in the main web app).
